# Resend API key (https://resend.com/api-keys). Required: without it the contact form returns an error.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (Domains → add makvion.com, add the DNS records).
RESEND_FROM_EMAIL="Makvion <noreply@makvion.com>"
# Where enquiries are delivered. Defaults to contact@makvion.com.
CONTACT_TO_EMAIL=contact@makvion.com
# Set to "true" to also send the visitor a short confirmation email. Default: off.
RESEND_SEND_CONFIRMATION=false
